# ============================================================
# .gitignore — Thư mục gốc
# ============================================================

# Môi trường ảo Python
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dữ liệu nhạy cảm & runtime (không đưa lên git!)
data/
*.db
*.db-wal
*.db-shm

# Model ONNX (tải riêng — kích thước lớn)
models/

# Snapshot ảnh
snapshots/

# Logs
logs/

# Cấu hình cục bộ (chứa hash mật khẩu — không commit!)
config.json
*.local
.env

# Node.js
node_modules/

# Flutter / Dart (mobile)
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies

# IDE
.vscode/
.idea/

# Hệ điều hành
Thumbs.db
Desktop.ini
.DS_Store
